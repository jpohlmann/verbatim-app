{
  "expo": {
    "name": "Verbatim AI",
    "slug": "verbatim-ai",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "myapp",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/7efb42fb-55eb-4409-8ff1-3a9ca1524459"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.jpohlmann.verbatim-ai",
      "buildNumber": "1.0.4",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Verbatim needs to use the device microphone to record the session.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "io.jpohlmann.verbatimai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "7efb42fb-55eb-4409-8ff1-3a9ca1524459"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
